# Copy to `.env` and fill in real values. NEVER commit `.env`.
#   cp .env.example .env
#   chmod 600 .env
#   openssl rand -hex 32   # -> set as BETTER_AUTH_SECRET

PAPERCLIP_PORT=3100
PAPERCLIP_DATA_DIR=/home/dev/data/paperclip

PAPERCLIP_PUBLIC_URL=http://10.20.10.128:3100
PAPERCLIP_ALLOWED_HOSTNAMES=10.20.10.128,paper.go7s.net

PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
PAPERCLIP_MIGRATION_AUTO_APPLY=true
PAPERCLIP_DB_BACKUP_ENABLED=true

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32

# UID/GID of the account running the deployment (`id -u dev` / `id -g dev`)
USER_UID=1000
USER_GID=1000

# LLM provider keys (optional; leave empty to start without them)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional Anthropic-compatible endpoint override (self-hosted router/gateway).
# When set, claude_local agents call <ANTHROPIC_BASE_URL>/v1/messages.
ANTHROPIC_BASE_URL=
GEMINI_API_KEY=
